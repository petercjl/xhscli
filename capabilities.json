      "default": "xhscli",
      "selector": {
        "option": "--skill",
        "type": "string"
      },
      "enumeration": {
        "argv": [
          "skill",
          "source",
          "--all",
          "--json"
        ],
        "itemsField": "sources",
        "completeField": "complete"
      },
      "namedSource": [
        "skill",
        "source",
        "--skill",
        "{skill}",
        "--json"
      ]
    }
  },
  "package": "@petercjl/xhscli",
  "version": "0.1.0-dev.0",
  "tool": "xhscli",
  "entry": "src/cli.mjs",
  "skills": [
    "xhscli"
  ],
  "installationLifecycle": {
    "agentNeutral": true,
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installationMode": "copy",
    "isolatedRuntimeRequired": true,
    "sharedLinksAllowed": false,
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill"
    ],
    "install": "resolve current host target, discover skill source, install physical runtime and verify receipt",
    "update": "resolve selected target before npm replacement, preserve edits and backup, reconcile same-version Skill",
    "verification": "matching CLI and Skill versions, SHA-256 integrity, explicit host discovery verification",
    "installGuide": "INSTALL.md",
    "updateGuide": "UPDATE.md"
  },
  "automaticUpdates": {
    "enabledByDefault": true,
    "intervalHours": 6,
    "timeoutMs": 1800,
    "trigger": "ordinary business task entry, source and owned runtimes use their owner",
    "configuration": "selected target via explicit option or per-package target environment",
    "disable": "AGENT_PACKAGE_UPDATE_CHECK=0",
    "recovery": "preserve current package offline; partial update operation record requires inspection",
    "defaultMode": "notify"
  }
}
