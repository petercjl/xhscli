    "search": {
      "description": "Export Xiaohongshu web note-search results to a new Excel workbook.",
      "sideEffects": "local-write",
      "options": {
        "--keyword": {
          "type": "string",
          "required": true
        },
        "--output": {
          "type": "string",
          "required": true,
          "semantics": "New .xlsx path with an existing parent directory"
        },
        "--pages": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "semantics": "Maximum number of pages exported starting from --start-page"
        },
        "--start-page": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "semantics": "Earlier pages load sequentially"
        },
        "--page-size": {
          "type": "integer",
          "enum": [
            20
          ],
          "default": 20
        },
        "--sort": {
          "type": "string",
          "enum": [
            "general",
            "latest",
            "likes",
            "comments",
            "saves"
          ],
          "default": "general"
        },
        "--note-type": {
          "type": "string",
          "enum": [
            "all",
            "video",
            "image"
          ],
          "default": "all"
        },
        "--published-within": {
          "type": "string",
          "enum": [
            "all",
            "day",
            "week",
            "half-year"
          ],
          "default": "all"
        },
        "--scope": {
          "type": "string",
          "enum": [
            "all",
            "viewed",
            "unviewed",
            "following"
          ],
          "default": "all"
        },
        "--distance": {
          "type": "string",
          "enum": [
            "all",
            "city",
            "nearby"
          ],
          "default": "all"
        },
        "--json": {
          "type": "boolean"
        }
      },
      "requestPacing": {
        "minWaitMs": 2000,
        "maxWaitMs": 3000,
        "scope": "successive search/notes POST requests released by the command"
      },
      "example": "xhscli search --keyword 午睡枕 --sort latest --pages 2 --output 午睡枕.xlsx --json"
    },
    "note get": {
      "description": "Export a note and all web-accessible comments and replies to a new JSON file.",
      "sideEffects": "local-write",
      "options": {
        "--id": {
          "type": "string",
          "semantics": "24-character note ID. Resolves a current link from the local search cache or open Xiaohongshu tabs, otherwise attempts the ID URL."
        },
        "--url": {
          "type": "string",
          "semantics": "HTTPS Xiaohongshu note URL or xhslink.com share URL. Exactly one of --id and --url is required."
        },
        "--output": {
          "type": "string",
          "required": true,
          "semantics": "New .json file in an existing parent folder."
        },
        "--json": {
          "type": "boolean"
        }
      },
      "requestPacing": {
        "minWaitMs": 2000,
        "maxWaitMs": 3000,
        "scope": "Successive captured note-detail and comment API requests"
      },
      "completeness": "Success requires top-level and every reply thread pagination to end. A partial export has ok=false, exit status 1, and completeness.failure in the output.",
      "example": "xhscli note get --id <NOTE_ID> --output note.json --json"
    }
  },
